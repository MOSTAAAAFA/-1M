# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
MONGO_URI=mongodb://localhost:27017/porsche-store

# JWT - CRITICAL SECURITY SETTING
# NEVER use weak secrets like "secret123", "password", or default values
# Generate a cryptographically secure secret (minimum 32 chars, 64+ for production):
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# The server will validate JWT_SECRET strength at startup and refuse to start with weak secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-GENERATE-WITH-CRYPTO
JWT_EXPIRE=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@1mmotors.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Groq AI
GROQ_API_KEY=your_groq_api_key

# Voice Mode - Google Cloud Text-to-Speech
# Option 1: API Key (easiest)
GOOGLE_CLOUD_API_KEY=your_api_key_here

# Option 2: Service Account JSON (more secure)
# GOOGLE_APPLICATION_CREDENTIALS=./config/google-tts-key.json
# GOOGLE_CLOUD_PROJECT=your-project-id

# Logging
LOG_LEVEL=info

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# AWS S3 (Optional - for file uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket-name
